#!/bin/bash
# A fresh development window; existing windows and sessions are preserved.
set -euo pipefail
if [[ "${1:-}" == --hint ]]; then
  printf '%s\n' 'DEV WORKSPACE' '' 'Ctrl+B, release, then:' \
    'h j k l   Move pane' '| / -     Split pane' 'z         Zoom / restore' \
    'd         Detach' '?         All bindings' '' \
    'Bottom: builds, tests, Git' 'Here: btop, logs, or codex' 'keys: full cheat sheet'
  exit 0
fi
name=''
directory="$PWD"
explicit=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) echo 'Usage: devlayout [session-name] [project-directory]'; echo 'Also: devlayout --session NAME --dir DIR'; exit 0 ;;
    --session) [[ $# -ge 2 ]] || exit 2; name="$2"; explicit=true; shift 2 ;;
    --dir) [[ $# -ge 2 ]] || exit 2; directory="$2"; shift 2 ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *)
      if [[ "$explicit" == false && -d "$1" ]]; then
        directory="$1"; shift
      elif [[ "$explicit" == false ]]; then
        name="$1"; explicit=true; shift
      else
        directory="$1"; shift
      fi ;;
  esac
done
if $explicit && [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo 'Session names may contain letters, numbers, underscores and hyphens.' >&2
  exit 2
fi
project="$(cd "$directory" && pwd)"
command -v tmux >/dev/null || { echo 'tmux is required.' >&2; exit 1; }
command -v vim >/dev/null || { echo 'vim is required.' >&2; exit 1; }
attach=false
session="${name:-dev}"
if [[ -n "${TMUX:-}" ]] && ! $explicit; then
  top=$(tmux new-window -P -F '#{pane_id}' -n code -c "$project")
elif tmux has-session -t "=$session" 2>/dev/null; then
  top=$(tmux new-window -t "=$session:" -P -F '#{pane_id}' -n code -c "$project")
  attach=true
else
  cols=$(tput cols 2>/dev/null || echo 120)
  rows=$(tput lines 2>/dev/null || echo 40)
  top=$(tmux new-session -d -s "$session" -n code -x "$cols" -y "$rows" -P -F '#{pane_id}' -c "$project")
  attach=true
fi
# Split the full-width bottom first, then divide only the upper area.
bottom=$(tmux split-window -t "$top" -v -l 28% -c "$project" -P -F '#{pane_id}')
right=$(tmux split-window -t "$top" -h -l 30% -c "$project" -P -F '#{pane_id}')
tmux select-pane -t "$top" -T Editor
tmux select-pane -t "$right" -T Companion
tmux select-pane -t "$bottom" -T Terminal
# Reapply proportions when a client changes the window dimensions.
# This is scoped to this new window; manual pane-border dragging still works.
tmux set-hook -w -t "$top" window-resized "resize-pane -t $bottom -y 28% ; resize-pane -t $right -x 30%"
tmux resize-pane -t "$bottom" -y 28%
tmux resize-pane -t "$right" -x 30%
tmux send-keys -t "$top" 'if test -f src/main.rs; then vim src/main.rs; else vim; fi' Enter
tmux send-keys -t "$right" 'clear; devlayout --hint' Enter
tmux select-pane -t "$top"
if $attach; then
  if [[ -n "${TMUX:-}" ]]; then
    # run-shell can also invoke this without any attached client (smoke tests).
    if [[ -n "$(tmux display-message -p '#{client_name}')" ]]; then
      tmux switch-client -t "=$session"
    fi
  else
    exec tmux attach-session -t "=$session" \; resize-pane -t "$bottom" -y 28% \; resize-pane -t "$right" -x 30%
  fi
fi
